{
  "manifest_version": 3,
  "name": "DragWheel for Browser",
  "short_name": "DragWheel",
  "version": "1.0.4",
  "description": "Right-click any video, song or link to play it in a DragWheel Float, or any picture to save it in the format you choose.",
  "author": "ilukezippo",
  "homepage_url": "https://ilukezippo.github.io/DragWheel/",
  "key": "",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "permissions": [
    "contextMenus",
    "nativeMessaging",
    "scripting",
    "activeTab"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "background": {
    "service_worker": "background.js",
    "scripts": [
      "background.js"
    ]
  },
  "action": {
    "default_title": "DragWheel",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png"
    }
  },
  "browser_specific_settings": {
    "gecko": {
      "id": "dragwheel@ilukezippo",
      "strict_min_version": "128.0",
      "data_collection_permissions": {
        "required": [
          "none"
        ]
      }
    }
  }
}