; Installer text in the app's other languages (made from scratchpad nsis_tr.py)

LangString WelcomeTitle   ${LANG_FRENCH} "Bienvenue dans ${APPNAME}"
LangString WelcomeText    ${LANG_FRENCH} "Faites glisser un fichier, appuyez sur une touche, déposez-le sur la roue.$\r$\n$\r$\nAppuyez sur Maj pour convertir, Ctrl pour les outils (compresser, recadrer, couper…) ou Alt pour les actions.$\r$\n$\r$\nTout se fait sur votre PC — rien n'est envoyé en ligne.$\r$\n$\r$\n${APPNAME} sera installé pour tous les utilisateurs dans Program Files.$\r$\n$\r$\nCliquez sur Suivant pour continuer."
LangString PasteHere      ${LANG_FRENCH} "Enregistrer l'image du presse-papiers ici"
LangString OpenFloat      ${LANG_FRENCH} "Ouvrir un flottant"
LangString PlayLink       ${LANG_FRENCH} "Coller le lien dans Float"
LangString UpdateNotNow   ${LANG_FRENCH} "La mise à jour a été annulée pour laisser vos tâches en cours se terminer. Relancez l'installation quand elles seront finies."
LangString UpdateTitle    ${LANG_FRENCH} "Mettre à jour ${APPNAME}"
LangString UpdateText     ${LANG_FRENCH} "${APPNAME} $OldVersion est installé sur ce PC.$\r$\n$\r$\nL'installation va le fermer, supprimer l'ancienne version et installer ${APPNAME} ${APPVERSION}. Vos réglages sont conservés.$\r$\n$\r$\nCliquez sur Suivant pour continuer."
LangString SameVersion    ${LANG_FRENCH} "${APPNAME} ${APPVERSION} est déjà installé sur ce PC.$\r$\n$\r$\nOui — le réinstaller (vos réglages sont conservés)$\r$\nNon — le désinstaller$\r$\nAnnuler — fermer l'installation"
LangString ReinstallTitle ${LANG_FRENCH} "Réinstaller ${APPNAME} ${APPVERSION}"
LangString ReinstallText  ${LANG_FRENCH} "L'installation va fermer ${APPNAME} et réinstaller la version ${APPVERSION}. Vos réglages sont conservés.$\r$\n$\r$\nCliquez sur Suivant pour continuer."
LangString RemovingOld    ${LANG_FRENCH} "Suppression de ${APPNAME} $OldVersion…"
LangString RunNow         ${LANG_FRENCH} "Lancer ${APPNAME} maintenant"
LangString FinishText     ${LANG_FRENCH} "${APPNAME} se trouve dans la zone de notification.$\r$\n$\r$\nFaites glisser un fichier et appuyez sur Maj pour l'essayer."
LangString UnSecApp       ${LANG_FRENCH} "${APPNAME} (l'application, ses menus et raccourcis)"
LangString UnSecSettings  ${LANG_FRENCH} "Supprimer aussi mes réglages"
LangString UnSecDownloads ${LANG_FRENCH} "Supprimer aussi les modèles IA et outils téléchargés"
LangString UnSecAppDesc   ${LANG_FRENCH} "Supprime ${APPNAME} de ce PC."
LangString UnSecSettingsDesc ${LANG_FRENCH} "Vos réglages, préréglages, chaînes, liens enregistrés, dossiers surveillés et le journal. Laissez décoché pour les garder si vous réinstallez ${APPNAME}."
LangString UnSecDownloadsDesc ${LANG_FRENCH} "Les modèles IA et yt-dlp téléchargés après l'installation (ils peuvent peser plusieurs centaines de Mo)."
LangString SecDlGroup     ${LANG_FRENCH} "Téléchargements facultatifs"
LangString SecDlBg        ${LANG_FRENCH} "Supprimer l'arrière-plan — modèle IA (178 Mo)"
LangString SecDlSpeech    ${LANG_FRENCH} "Parole en texte — modèle IA (190 Mo)"
LangString SecDlLinks     ${LANG_FRENCH} "Lire YouTube et d'autres liens — yt-dlp (18 Mo)"
LangString SecDlDesc      ${LANG_FRENCH} "Des éléments téléchargés une seule fois au lieu d'être inclus dans l'installateur. ${APPNAME} télécharge ceux qui sont cochés dès son démarrage. Ce que vous ignorez vous sera proposé à la première utilisation."
LangString SecDlBgDesc    ${LANG_FRENCH} "Supprime l'arrière-plan des photos (Outils → Supprimer l'arrière-plan, et dans Recadrer et redimensionner). Fonctionne hors ligne."
LangString SecDlSpeechDesc ${LANG_FRENCH} "Transforme la parole des vidéos et enregistrements en sous-titres et en texte, arabe compris (Outils → Transcrire). Fonctionne hors ligne."
LangString SecDlLinksDesc ${LANG_FRENCH} "Permet à Float de lire des liens de YouTube et d'environ 1 800 autres sites (Coller le lien dans Float)."
LangString SecCoreName    ${LANG_FRENCH} "${APPNAME} (requis)"
LangString SecMenuName    ${LANG_FRENCH} "Menu clic droit de l'Explorateur et Envoyer vers"
LangString SecStartupName ${LANG_FRENCH} "Démarrer avec Windows"
LangString SecDesktopName ${LANG_FRENCH} "Raccourci sur le bureau"
LangString SecCoreDesc    ${LANG_FRENCH} "L'application ${APPNAME} et son raccourci dans le menu Démarrer."
LangString SecMenuDesc    ${LANG_FRENCH} "Ajoute ${APPNAME} au clic droit sur les fichiers et dossiers, ainsi qu'une entrée dans Envoyer vers."
LangString SecStartupDesc ${LANG_FRENCH} "Lance ${APPNAME} dans la zone de notification à l'ouverture de session, pour que glisser-appuyer marche toujours."
LangString SecDesktopDesc ${LANG_FRENCH} "Place un raccourci ${APPNAME} sur le bureau."
LangString AlreadyRunning ${LANG_FRENCH} "Le programme d'installation de ${APPNAME} est déjà ouvert."
LangString NeedAdmin      ${LANG_FRENCH} "L'installation de ${APPNAME} nécessite les droits d'administrateur. Faites un clic droit dessus et choisissez « Exécuter en tant qu'administrateur »."
LangString Need64         ${LANG_FRENCH} "${APPNAME} nécessite Windows 10 ou 11 en 64 bits."

LangString WelcomeTitle   ${LANG_SPANISH} "Te damos la bienvenida a ${APPNAME}"
LangString WelcomeText    ${LANG_SPANISH} "Arrastra un archivo, pulsa una tecla y suéltalo en la rueda.$\r$\n$\r$\nPulsa Mayús para convertir, Ctrl para herramientas (comprimir, recortar, cortar…) o Alt para acciones.$\r$\n$\r$\nTodo funciona en tu PC: no se sube nada.$\r$\n$\r$\n${APPNAME} se instalará para todos los usuarios en Program Files.$\r$\n$\r$\nHaz clic en Siguiente para continuar."
LangString PasteHere      ${LANG_SPANISH} "Guardar aquí la imagen del portapapeles"
LangString OpenFloat      ${LANG_SPANISH} "Abrir flotante"
LangString PlayLink       ${LANG_SPANISH} "Pegar enlace en Float"
LangString UpdateNotNow   ${LANG_SPANISH} "Se canceló la actualización para que terminen tus tareas en curso. Vuelve a ejecutar el instalador cuando acaben."
LangString UpdateTitle    ${LANG_SPANISH} "Actualizar ${APPNAME}"
LangString UpdateText     ${LANG_SPANISH} "${APPNAME} $OldVersion está instalado en este PC.$\r$\n$\r$\nEl instalador lo cerrará, quitará la versión anterior e instalará ${APPNAME} ${APPVERSION}. Tus ajustes se conservan.$\r$\n$\r$\nHaz clic en Siguiente para continuar."
LangString SameVersion    ${LANG_SPANISH} "${APPNAME} ${APPVERSION} ya está instalado en este PC.$\r$\n$\r$\nSí — reinstalarlo (tus ajustes se conservan)$\r$\nNo — desinstalarlo$\r$\nCancelar — cerrar el instalador"
LangString ReinstallTitle ${LANG_SPANISH} "Reinstalar ${APPNAME} ${APPVERSION}"
LangString ReinstallText  ${LANG_SPANISH} "El instalador cerrará ${APPNAME} e instalará de nuevo la versión ${APPVERSION}. Tus ajustes se conservan.$\r$\n$\r$\nHaz clic en Siguiente para continuar."
LangString RemovingOld    ${LANG_SPANISH} "Quitando ${APPNAME} $OldVersion…"
LangString RunNow         ${LANG_SPANISH} "Iniciar ${APPNAME} ahora"
LangString FinishText     ${LANG_SPANISH} "${APPNAME} vive en la bandeja del sistema.$\r$\n$\r$\nArrastra cualquier archivo y pulsa Mayús para probarlo."
LangString UnSecApp       ${LANG_SPANISH} "${APPNAME} (la aplicación, sus menús y accesos directos)"
LangString UnSecSettings  ${LANG_SPANISH} "Quitar también mis ajustes"
LangString UnSecDownloads ${LANG_SPANISH} "Quitar también los modelos de IA y herramientas descargados"
LangString UnSecAppDesc   ${LANG_SPANISH} "Quita ${APPNAME} de este PC."
LangString UnSecSettingsDesc ${LANG_SPANISH} "Tus ajustes, preajustes, cadenas, enlaces guardados, carpetas vigiladas y el registro. Déjalo sin marcar para conservarlos si vuelves a instalar ${APPNAME}."
LangString UnSecDownloadsDesc ${LANG_SPANISH} "Los modelos de IA y yt-dlp descargados después de instalar (pueden ocupar varios cientos de MB)."
LangString SecDlGroup     ${LANG_SPANISH} "Descargas opcionales"
LangString SecDlBg        ${LANG_SPANISH} "Quitar fondo — modelo de IA (178 MB)"
LangString SecDlSpeech    ${LANG_SPANISH} "Voz a texto — modelo de IA (190 MB)"
LangString SecDlLinks     ${LANG_SPANISH} "Reproducir YouTube y otros enlaces — yt-dlp (18 MB)"
LangString SecDlDesc      ${LANG_SPANISH} "Partes que se descargan una vez en lugar de ir dentro del instalador. ${APPNAME} descarga las marcadas justo al iniciarse. Lo que omitas se te ofrecerá la primera vez que lo uses."
LangString SecDlBgDesc    ${LANG_SPANISH} "Quita el fondo de las fotos (Herramientas → Quitar fondo, y en Recortar y redimensionar). Funciona sin conexión."
LangString SecDlSpeechDesc ${LANG_SPANISH} "Convierte la voz de vídeos y grabaciones en subtítulos y texto, árabe incluido (Herramientas → Transcribir). Funciona sin conexión."
LangString SecDlLinksDesc ${LANG_SPANISH} "Permite que Float reproduzca enlaces de YouTube y de unos 1800 sitios más (Pegar enlace en Float)."
LangString SecCoreName    ${LANG_SPANISH} "${APPNAME} (obligatorio)"
LangString SecMenuName    ${LANG_SPANISH} "Menú contextual del Explorador y Enviar a"
LangString SecStartupName ${LANG_SPANISH} "Iniciar con Windows"
LangString SecDesktopName ${LANG_SPANISH} "Acceso directo en el escritorio"
LangString SecCoreDesc    ${LANG_SPANISH} "La aplicación ${APPNAME} y su acceso directo en el menú Inicio."
LangString SecMenuDesc    ${LANG_SPANISH} "Añade ${APPNAME} al hacer clic derecho en archivos o carpetas, y una entrada en Enviar a."
LangString SecStartupDesc ${LANG_SPANISH} "Inicia ${APPNAME} en la bandeja al iniciar sesión, para que arrastrar y pulsar funcione siempre."
LangString SecDesktopDesc ${LANG_SPANISH} "Pone un acceso directo de ${APPNAME} en el escritorio."
